demo_ls_json() {
  local path="$1"
  case "$path" in
    */Documents)
      jq -nc --arg p "$path" --argjson now "$(date +%s)" '
        def iso($t): $t | strftime("%Y-%m-%dT%H:%M:%S+00:00");
        {ok:true, path:$p, truncated:false, entries:[
          {name:"Contracts",        type:"dir",  path:($p+"/Contracts"),        size:null,    mtime:iso($now-1209600)},
          {name:"Invoices",         type:"dir",  path:($p+"/Invoices"),         size:null,    mtime:iso($now-604800)},
          {name:"Photos",           type:"dir",  path:($p+"/Photos"),           size:null,    mtime:iso($now-259200)},
          {name:"Presentations",    type:"dir",  path:($p+"/Presentations"),    size:null,    mtime:iso($now-172800)},
          {name:"annual-report.pdf",type:"file", path:($p+"/annual-report.pdf"),size:2418176, mtime:iso($now-345600)},
          {name:"budget-2026.ods",  type:"file", path:($p+"/budget-2026.ods"),  size:184320,  mtime:iso($now-86400)},
          {name:"meeting-notes.md", type:"file", path:($p+"/meeting-notes.md"), size:8412,    mtime:iso($now-43200)},
          {name:"roadmap.excalidraw", type:"file", path:($p+"/roadmap.excalidraw"), size:96231, mtime:iso($now-129600)}
        ]}' ;;
    *)
      jq -nc --arg p "$path" --argjson now "$(date +%s)" '
        def iso($t): $t | strftime("%Y-%m-%dT%H:%M:%S+00:00");
        {ok:true, path:$p, truncated:false, entries:[
          {name:"Documents",  type:"dir", path:($p+"/Documents"),  size:null, mtime:iso($now-43200)},
          {name:"Downloads",  type:"dir", path:($p+"/Downloads"),  size:null, mtime:iso($now-7200)},
          {name:"Music",      type:"dir", path:($p+"/Music"),      size:null, mtime:iso($now-2592000)},
          {name:"Pictures",   type:"dir", path:($p+"/Pictures"),   size:null, mtime:iso($now-604800)},
          {name:"Projects",   type:"dir", path:($p+"/Projects"),   size:null, mtime:iso($now-3600)},
          {name:"Videos",     type:"dir", path:($p+"/Videos"),     size:null, mtime:iso($now-1209600)},
          {name:".zshrc",     type:"file", path:($p+"/.zshrc"),    size:4821, mtime:iso($now-864000)}
        ]}' ;;
  esac
}

cmd_demo() {
  case "${1:-status}" in
    on)
      mkdir -p -m 700 -- "$STATE_DIR"
      printf '%s\n' "${2:-idle}" | write_private "$DEMO_FILE"
      printf 'Demo mode is on. Every read returns invented data and every write is a no-op.\n'
      printf 'Turn it off with: omarchy-time-machine demo off\n'
      ;;
    off)
      rm -f -- "$DEMO_FILE"
      printf 'Demo mode is off.\n'
      ;;
    status)
      demo_on && printf '%s\n' "$(demo_scene)" || printf 'off\n'
      ;;
    *)
      die "usage: demo on [idle|running|failed] | off | status"
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

usage() {
  cat <<TEXT
omarchy-time-machine $VERSION

  status --json                       status of every destination (no network)
  destinations [--json]               list every destination and when it last ran
  key set|show --dest <name>          manage the repository password
  key save-1password --dest <name>    copy it into 1Password, optionally --vault V
  init --dest <name>                  create the repository
  backup [--dest <name>] [--dry-run]  run a backup
  snapshots --dest <name> --json      list snapshots
  ls --dest <name> --snapshot <id> --path </abs> --json
  restore --dest <name> --snapshot <id> --path </abs> [--target <dir>]
  check --dest <name>                 verify repository integrity
  install                             (re)write and enable the systemd units
  config create                       write a starter configuration
  log [--dest <name>]                 path of the most recent log file
  demo on|off|status                  invented data for screenshots; writes become no-ops
TEXT
}

main() {
  need jq
  local command="${1:-}"
  [ "$#" -gt 0 ] && shift

  case "$command" in
    status) cmd_status "$@" ;;
    destinations) cmd_destinations "$@" ;;
    key) cmd_key "$@" ;;
    init) need restic; cmd_init "$@" ;;
    backup) need restic; cmd_backup "$@" ;;
    snapshots) need restic; cmd_snapshots "$@" ;;
    ls) need restic; cmd_ls "$@" ;;
    restore) need restic; cmd_restore "$@" ;;
    check) need restic; cmd_check "$@" ;;
    install) cmd_install "$@" ;;
    report-failure) cmd_report_failure "$@" ;;
    log) cmd_log "$@" ;;
    config) cmd_config "$@" ;;
    demo) cmd_demo "$@" ;;
    --version) printf '%s\n' "$VERSION" ;;
    ""|help|--help|-h) usage ;;
    *) printf 'unknown command: %s\n' "$command" >&2; usage >&2; return 2 ;;
  esac
}

main "$@"
